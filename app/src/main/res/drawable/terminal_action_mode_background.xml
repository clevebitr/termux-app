<?xml version="1.0" encoding="utf-8"?>
<!--
  The background of the floating text selection toolbar (the system ActionMode), which is shown above
  the selection handles. It uses the row corner token and a 1dp border, so that the toolbar is rounded like the
  dialogs and rows of the app instead of having the square corners of the old tui style.

  NOTE: The colors are the ones of the app theme and not of the `colors.properties` file, since a
  drawable cannot be built from the colors of the termux color scheme at runtime.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/termuxActivityDrawerBackground" />
    <stroke
        android:width="1dp"
        android:color="?attr/termuxActivityDrawerImageTint" />
    <corners android:radius="@dimen/termux_row_corner_radius" />
</shape>
