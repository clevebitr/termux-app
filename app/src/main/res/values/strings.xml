                <string name="termux_soft_keyboard_toggle_behaviour_show_hide">Show/hide the keyboard (Default)</string>
                <string name="termux_soft_keyboard_toggle_behaviour_enable_disable">Enable/disable the keyboard</string>

                <!-- Hide Soft Keyboard On Startup -->
                <string name="termux_hide_soft_keyboard_on_startup_title">Hide Keyboard on Startup</string>
                <string name="termux_hide_soft_keyboard_on_startup_off">The soft keyboard state is not changed when the
                    app starts. (Default)</string>
                <string name="termux_hide_soft_keyboard_on_startup_on">The soft keyboard is hidden when the app
                    starts.</string>

                <!-- Hide Extra Keys When Soft Keyboard Hidden -->
                <string name="termux_hide_extra_keys_when_soft_keyboard_hidden_title">Hide Extra Keys When Keyboard
                    Hidden</string>
                <string name="termux_hide_extra_keys_when_soft_keyboard_hidden_off">The extra keys row is kept visible
                    while the soft keyboard is hidden. (Default)</string>
                <string name="termux_hide_extra_keys_when_soft_keyboard_hidden_on">The extra keys row is hidden while
                    the soft keyboard is hidden, so that the terminal gets its rows, and is shown again when the soft
                    keyboard is shown. Requires Android 6 or later. The toolbar can still be shown manually, which is
                    kept until the soft keyboard visibility changes again.</string>

                <!-- Touch Drag Sends Mouse Drag -->
                <string name="termux_touch_drag_sends_mouse_drag_title">Touch Drag Sends Mouse Drag</string>
                <string name="termux_touch_drag_sends_mouse_drag_off">Dragging with a finger sends scroll wheel
                    events to terminal programs that use mouse tracking. (Default)</string>
                <string name="termux_touch_drag_sends_mouse_drag_on">Dragging with a finger is reported as a drag of
                    the mouse pointer, which programs that support dragging, like for selecting text or resizing
                    panes in a TUI, can handle. Scrolling with a drag is then not reported as scroll wheel events
                    to programs that use mouse tracking.</string>

                <!-- Mouse Tap Shows Keyboard -->
                <string name="termux_mouse_tap_shows_keyboard_title">Show Keyboard on Mouse Tap</string>
                <string name="termux_mouse_tap_shows_keyboard_off">Taps with a mouse or while mouse tracking is active
                    are forwarded to the terminal and do not show the soft keyboard. (Default)</string>
                <string name="termux_mouse_tap_shows_keyboard_on">The soft keyboard is shown for those taps too, which
                    can be convenient, but may conflict with terminal programs that use mouse tracking or
                    clicking, like TUIs.</string>

                <!-- Disable Hardware Keyboard Shortcuts -->
                <string name="termux_disable_hardware_keyboard_shortcuts_title">Disable Hardware Keyboard
                    Shortcuts</string>
                <string name="termux_disable_hardware_keyboard_shortcuts_off">Shortcuts like Ctrl+Alt+C to create a new
                    session are handled by the app. (Default)</string>
                <string name="termux_disable_hardware_keyboard_shortcuts_on">The key combinations are sent to the
                    terminal instead, so that the app does not intercept them.</string>

