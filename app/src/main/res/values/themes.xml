<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
     https://material.io/develop/android/theming/dark
    -->

    <!--
      The themes of the fork are Material 3 themes. The base themes of the shared library are Material 2 and
      cannot be changed, since the module is read only, so the app defines its own parents here and keeps the
      names that the manifest and the activities use.
    -->

    <!-- TermuxApp Light DarkActionBar theme. -->
    <style name="Theme.TermuxApp.Light.DarkActionBar" parent="Theme.Material3.Light">
        <!-- The worktree keeps the red of the upstream theme as the primary color, so that the Material 3
             components match the terminal colors of the fork. -->
        <item name="colorPrimary">@color/red_400</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/red_400</item>
        <item name="colorOnPrimaryContainer">@color/grey_900</item>

        <item name="colorSecondary">@color/grey_800</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/grey_200</item>
        <item name="colorOnSecondaryContainer">@color/grey_900</item>

        <item name="colorOutline">@color/grey_500</item>

        <item name="android:textColorLink">@color/blue_link_light</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Termux.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Termux.Dialog</item>
    </style>
    <!-- TermuxApp Light NoActionBar theme. -->
    <style name="Theme.TermuxApp.Light.NoActionBar" parent="Theme.TermuxApp.Light.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- TermuxApp DayNight DarkActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.DarkActionBar" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/red_400</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/red_800</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/grey_400</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/grey_800</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <item name="colorOutline">@color/grey_500</item>

        <item name="android:textColorLink">@color/blue_link_dark</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Termux.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Termux.Dialog</item>
    </style>
    <!-- TermuxApp DayNight NoActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!--
      The platform and the shared library dialogs are drawn by the fork on a Material 3 surface and rounded by
      the same corner token that the dialogs of the fork use for their own windows, so that a dialog looks the
      same whichever layer creates it.
    -->
    <style name="ThemeOverlay.Termux.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Termux.Dialog</item>
    </style>

    <style name="ShapeAppearance.Termux.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/termux_dialog_corner_radius</item>
    </style>


    <!-- TermuxActivity DayNight NoActionBar theme. -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>

        <item name="android:windowBackground">@color/black</item>

        <!-- Avoid action mode toolbar pushing down terminal content when
             selecting text on pre-6.0 (non-floating toolbar). -->
        <item name="android:windowActionModeOverlay">true</item>

        <!-- The floating text selection toolbar, styled like the tui windows of the fork with square
             corners and a 1dp border instead of the material design pill. -->
        <item name="actionModeBackground">@drawable/terminal_action_mode_background</item>
        <item name="actionModeSplitBackground">@drawable/terminal_action_mode_background</item>
        <item name="actionMenuTextColor">?attr/termuxActivityDrawerImageTint</item>

        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- https://developer.android.com/training/tv/start/start.html#transition-color -->
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>

        <!-- Left drawer. -->
        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Light</item>
        <item name="termuxActivityDrawerBackground">@color/white</item>
        <item name="termuxActivityDrawerImageTint">@color/black</item>

        <!-- Extra keys colors. -->
        <item name="extraKeysButtonTextColor">@color/white</item>
        <item name="extraKeysButtonActiveTextColor">@color/red_400</item>
        <item name="extraKeysButtonBackgroundColor">@color/black</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/grey_500</item>
    </style>

</resources>
