<?xml version="1.0" encoding="utf-8"?>
<!--
    The locales supported by the app, used by the per-app language picker on Android 13+ (API 33+)
    at Settings -> Apps -> Termux -> Language. Each locale must have a matching `values-<locale>`
    resource directory, like `values-zh` for `zh`, otherwise it will fall back to the default
    English resources. See FORK.md for how to add a new language.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="zh" />
</locale-config>
