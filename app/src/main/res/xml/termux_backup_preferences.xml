<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="backup"
        app:title="@string/termux_backup_category_title"
        app:summary="@string/termux_backup_category_summary">

        <Preference
            app:key="backup_now"
            app:persistent="false"
            app:title="@string/termux_backup_now_title"
            app:summary="@string/termux_backup_now_summary" />

        <Preference
            app:key="restore_now"
            app:persistent="false"
            app:title="@string/termux_restore_now_title"
            app:summary="@string/termux_restore_now_summary" />

        <Preference
            app:key="install_commands"
            app:persistent="false"
            app:title="@string/termux_backup_install_commands_title"
            app:summary="@string/termux_backup_install_commands_summary" />

    </PreferenceCategory>

</PreferenceScreen>
