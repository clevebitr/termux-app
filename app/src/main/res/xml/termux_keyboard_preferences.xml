<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="input_method"
        app:title="@string/termux_keyboard_input_method_header">

        <SwitchPreferenceCompat
            app:key="gboard-cjk-workaround"
            app:title="@string/termux_gboard_cjk_workaround_title"
            app:summaryOff="@string/termux_gboard_cjk_workaround_off"
            app:summaryOn="@string/termux_gboard_cjk_workaround_on" />

        <SwitchPreferenceCompat
            app:key="enforce-char-based-input"
            app:title="@string/termux_enforce_char_based_input_title"
            app:summaryOff="@string/termux_enforce_char_based_input_off"
            app:summaryOn="@string/termux_enforce_char_based_input_on" />

        <SwitchPreferenceCompat
            app:key="ctrl-space-workaround"
            app:title="@string/termux_ctrl_space_workaround_title"
            app:summaryOff="@string/termux_ctrl_space_workaround_off"
            app:summaryOn="@string/termux_ctrl_space_workaround_on" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="key_behaviour"
        app:title="@string/termux_keyboard_key_behaviour_header">

        <ListPreference
            app:defaultValue="back"
            app:entries="@array/termux_back_key_behaviour_entries"
            app:entryValues="@array/termux_back_key_behaviour_values"
            app:key="back-key"
            app:title="@string/termux_back_key_behaviour_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="virtual"
            app:entries="@array/termux_volume_keys_behaviour_entries"
            app:entryValues="@array/termux_volume_keys_behaviour_values"
            app:key="volume-keys"
            app:title="@string/termux_volume_keys_behaviour_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="show/hide"
            app:entries="@array/termux_soft_keyboard_toggle_behaviour_entries"
            app:entryValues="@array/termux_soft_keyboard_toggle_behaviour_values"
            app:key="soft-keyboard-toggle-behaviour"
            app:title="@string/termux_soft_keyboard_toggle_behaviour_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="hide-soft-keyboard-on-startup"
            app:summaryOff="@string/termux_hide_soft_keyboard_on_startup_off"
            app:summaryOn="@string/termux_hide_soft_keyboard_on_startup_on"
            app:title="@string/termux_hide_soft_keyboard_on_startup_title" />

        <SwitchPreferenceCompat
            app:key="hide-extra-keys-when-soft-keyboard-hidden"
            app:summaryOff="@string/termux_hide_extra_keys_when_soft_keyboard_hidden_off"
            app:summaryOn="@string/termux_hide_extra_keys_when_soft_keyboard_hidden_on"
            app:title="@string/termux_hide_extra_keys_when_soft_keyboard_hidden_title" />

        <SwitchPreferenceCompat
            app:key="touch-drag-sends-mouse-drag"
            app:summaryOff="@string/termux_touch_drag_sends_mouse_drag_off"
            app:summaryOn="@string/termux_touch_drag_sends_mouse_drag_on"
            app:title="@string/termux_touch_drag_sends_mouse_drag_title" />

        <SwitchPreferenceCompat
            app:key="mouse-tap-shows-keyboard"
            app:summaryOff="@string/termux_mouse_tap_shows_keyboard_off"
            app:summaryOn="@string/termux_mouse_tap_shows_keyboard_on"
            app:title="@string/termux_mouse_tap_shows_keyboard_title" />

        <SwitchPreferenceCompat
            app:key="disable-hardware-keyboard-shortcuts"
            app:summaryOff="@string/termux_disable_hardware_keyboard_shortcuts_off"
            app:summaryOn="@string/termux_disable_hardware_keyboard_shortcuts_on"
            app:title="@string/termux_disable_hardware_keyboard_shortcuts_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="extra_keys_colors"
        app:title="@string/termux_extra_keys_colors_header"
        app:summary="@string/termux_extra_keys_colors_summary">

        <com.termux.app.fragments.settings.termux.ColorPreference
            app:key="extra-keys-foreground"
            app:title="@string/termux_extra_keys_foreground_title" />

        <com.termux.app.fragments.settings.termux.ColorPreference
            app:key="extra-keys-background"
            app:title="@string/termux_extra_keys_background_title" />

        <com.termux.app.fragments.settings.termux.ColorPreference
            app:key="extra-keys-active-foreground"
            app:title="@string/termux_extra_keys_active_foreground_title" />

        <com.termux.app.fragments.settings.termux.ColorPreference
            app:key="extra-keys-active-background"
            app:title="@string/termux_extra_keys_active_background_title" />

    </PreferenceCategory>

</PreferenceScreen>
