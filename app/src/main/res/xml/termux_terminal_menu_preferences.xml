<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="terminal_menu_items"
        app:title="@string/termux_terminal_menu_items_header">

        <com.termux.app.ext.menu.TerminalMenuItemsPreference
            app:key="terminal-menu-items"
            app:summary="@string/termux_terminal_menu_items_summary"
            app:title="@string/termux_terminal_menu_items_title" />

        <com.termux.app.ext.menu.SelectionToolbarItemsPreference
            app:key="selection-toolbar-items"
            app:summary="@string/termux_terminal_menu_selection_items_summary"
            app:title="@string/termux_terminal_menu_selection_items_title" />

        <ListPreference
            app:defaultValue="auto"
            app:entries="@array/termux_mouse_right_click_entries"
            app:entryValues="@array/termux_mouse_right_click_values"
            app:key="mouse-right-click"
            app:summary="@string/termux_mouse_right_click_summary"
            app:title="@string/termux_mouse_right_click_title" />

    </PreferenceCategory>

</PreferenceScreen>
