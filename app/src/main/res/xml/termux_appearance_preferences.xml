<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="theme"
        app:title="@string/termux_appearance_theme_header">

        <ListPreference
            app:defaultValue="system"
            app:entries="@array/termux_appearance_night_mode_entries"
            app:entryValues="@array/termux_appearance_night_mode_values"
            app:key="night-mode"
            app:title="@string/termux_appearance_night_mode_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="fullscreen"
        app:title="@string/termux_appearance_fullscreen_header">

        <SwitchPreferenceCompat
            app:key="fullscreen"
            app:summaryOff="@string/termux_appearance_fullscreen_off"
            app:summaryOn="@string/termux_appearance_fullscreen_on"
            app:title="@string/termux_appearance_fullscreen_title" />

        <SwitchPreferenceCompat
            app:key="use-fullscreen-workaround"
            app:summaryOff="@string/termux_appearance_fullscreen_workaround_off"
            app:summaryOn="@string/termux_appearance_fullscreen_workaround_on"
            app:title="@string/termux_appearance_fullscreen_workaround_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="toolbar"
        app:title="@string/termux_appearance_toolbar_header">

        <ListPreference
            app:defaultValue="default"
            app:entries="@array/termux_appearance_extra_keys_style_entries"
            app:entryValues="@array/termux_appearance_extra_keys_style_values"
            app:key="extra-keys-style"
            app:title="@string/termux_appearance_extra_keys_style_title"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            android:max="300"
            android:min="40"
            app:defaultValue="100"
            app:key="terminal-toolbar-height"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:summary="@string/termux_appearance_toolbar_height_summary"
            app:title="@string/termux_appearance_toolbar_height_title" />

        <SwitchPreferenceCompat
            app:key="extra-keys-text-all-caps"
            app:summaryOff="@string/termux_appearance_extra_keys_text_all_caps_off"
            app:summaryOn="@string/termux_appearance_extra_keys_text_all_caps_on"
            app:title="@string/termux_appearance_extra_keys_text_all_caps_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="drawer"
        app:title="@string/termux_appearance_drawer_header">

        <ListPreference
            app:defaultValue="auto"
            app:entries="@array/termux_appearance_drawer_open_mode_entries"
            app:entryValues="@array/termux_appearance_drawer_open_mode_values"
            app:key="drawer-open-mode"
            app:summary="@string/termux_appearance_drawer_open_mode_summary"
            app:title="@string/termux_appearance_drawer_open_mode_title"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            app:defaultValue="96"
            app:key="drawer-handle-length"
            android:max="160"
            android:min="24"
            app:seekBarIncrement="8"
            app:showSeekBarValue="true"
            app:summary="@string/termux_appearance_drawer_handle_length_summary"
            app:title="@string/termux_appearance_drawer_handle_length_title" />

        <SeekBarPreference
            app:defaultValue="45"
            app:key="drawer-handle-opacity"
            android:max="100"
            android:min="10"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:summary="@string/termux_appearance_drawer_handle_opacity_summary"
            app:title="@string/termux_appearance_drawer_handle_opacity_title" />

        <SeekBarPreference
            app:defaultValue="50"
            app:key="drawer-handle-position"
            android:max="100"
            android:min="0"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:summary="@string/termux_appearance_drawer_handle_position_summary"
            app:title="@string/termux_appearance_drawer_handle_position_title" />

    </PreferenceCategory>

</PreferenceScreen>
