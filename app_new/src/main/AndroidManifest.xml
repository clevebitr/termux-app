<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        新外壳独立于旧模块 com.termux，使用独立包名，以便在设备上与旧应用并装对比。
        运行时（PTY、exec、bootstrap）将在后续里程碑中拆分，届时本模块通过契约连接运行时，
        详见 docs/UPGRADE.md 第 6 节。
    -->

    <application
        android:name=".ShellApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shell">

        <activity
            android:name=".ui.ShellActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:documentLaunchMode="always"
            android:exported="true"
            android:launchMode="standard"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Shell"
            tools:targetApi="n">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
