<?xml version="1.0" encoding="utf-8"?>
<!--
    外壳主布局。
    左侧为常驻侧栏，仅在中等与展开档位显示，宽度由 LayoutHost 按档位设置。
    右侧自上而下为标题行、标签栏与窗格宿主；标签栏在底部模式下由 LayoutHost 移动到内容末尾。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/shell_rail"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceVariant"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/shell_rail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shell_rail_title"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:id="@+id/shell_rail_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/shell_rail_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shell_rail_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shell_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/shell_header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/shell_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shell_action_palette"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/shell_command_palette"
                app:icon="@drawable/ic_search" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shell_action_new_tab"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/shell_new_tab"
                app:icon="@drawable/ic_tab_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shell_action_overflow"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/shell_overflow"
                app:icon="@drawable/ic_more_vert" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/shell_tab_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.termux.shell.ui.TabStripView
                android:id="@+id/shell_tab_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>

        <com.termux.shell.pane.PaneHostView
            android:id="@+id/shell_pane_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="4dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
